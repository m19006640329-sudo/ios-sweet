diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b926fe..b2772b3 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -30,6 +30,7 @@
 #include <miscfs/devfs/devfs.h>
 #include <kern/locks.h>
 #include <kern/clock.h>
+#include <kern/debug.h>
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <arm/caches_internal.h>
@@ -654,6 +655,30 @@ sweet_ufs_init(void)
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	/*
+	 * HFS+ keeps its volume header at byte 1024 of the volume, i.e. in
+	 * device block two. Read it here so a failed mount says whether the
+	 * partition actually holds an HFS+ image.
+	 */
+	{
+		static const char hex[] = "0123456789abcdef";
+		char sig[17];
+		int perr = ufs_read_blocks(su.first_block + 2, 1);
+		const uint8_t *vb = (const uint8_t *)(su.dma + DMA_BOUNCE);
+
+		if (perr == 0) {
+			for (int i = 0; i < 8; i++) {
+				sig[i * 2] = hex[vb[i] >> 4];
+				sig[i * 2 + 1] = hex[vb[i] & 0xf];
+			}
+			sig[16] = 0;
+			printf("SWEET UFS: volume header %s (482b is HFS+)\n", sig);
+			/* Stop here: the mount loop scrolls too fast to read. */
+			panic("SWEET UFS: volume header %s", sig);
+		} else {
+			printf("SWEET UFS: volume header read failed %d\n", perr);
+		}
+	}
 	sweet_log_start();
 	sweet_sample_start();
 	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
