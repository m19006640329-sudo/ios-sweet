+/* ------------------------------------------------------------------ */
+/* Generator macros: produce all orderings from base + suffix          */
+/* ------------------------------------------------------------------ */
+
+.macro GEN_LD_B base, op, sfx
+	LD_ATOMIC_B \base, \op, ld\sfx,  st\sfx
+	LD_ATOMIC_B \base\()a, \op, lda\sfx, st\sfx
