+/*
+ * Decode and emulate a userspace LSE instruction. Returns true if handled
+ * (PC advanced, result written back), false otherwise (fall through to the
+ * normal undefined-instruction / SIGSEGV path).
+ */
+static bool
+sagit_handle_lse(arm_saved_state_t *state, uint32_t instr)
+{
+	uint32_t opcode = (instr >> 25) & 0x1f;
+	uint32_t b21    = (instr >> 21) & 1;
+	uint32_t op_sub, size, rs, rn, rt;
+	uint32_t A = 0, L = 0;
+	bool     is_st;
+	int      op_idx, ord;
+	uint64_t addr, rs_val, rt_val;
+	sagit_lse_ret_t ret;
+
+	if (opcode == 0x1c && b21) {
+		/* LD/ST/SWP atomic */
+		op_sub = (instr >> 10) & 0x3f;
+		A = (instr >> 23) & 1;
+		L = (instr >> 22) & 1;
+	} else if (opcode == 0x04 && b21) {
+		/* CAS (op_sub is always 0x1f for CAS) */
+		op_sub = 0x1f;
+		A = (instr >> 22) & 1;
+		L = (instr >> 15) & 1;
+	} else {
+		return false;
+	}
+
+	size = (instr >> 30) & 3;
+	rs   = (instr >> 16) & 0x1f;
+	rn   = (instr >> 5) & 0x1f;
+	rt   = instr & 0x1f;
+	is_st = (opcode == 0x1c) && (rt == 31);
+
+	switch (op_sub) {
+	case 0x00: op_idx = 0; break; /* ADD  */
+	case 0x04: op_idx = 1; break; /* CLR  */
+	case 0x08: op_idx = 2; break; /* EOR  */
+	case 0x0c: op_idx = 3; break; /* SET  */
+	case 0x10: op_idx = 4; break; /* SMAX */
+	case 0x14: op_idx = 5; break; /* SMIN */
+	case 0x18: op_idx = 6; break; /* UMAX */
+	case 0x1c: op_idx = 7; break; /* UMIN */
+	case 0x20: op_idx = 8; break; /* SWP  */
+	case 0x1f: op_idx = 9; break; /* CAS  */
+	default:   return false;
+	}
+
+	/* ordering: 0=none, 1=acquire, 2=release, 3=acquire+release */
+	ord = (A ? 1 : 0) | (L ? 2 : 0);
+
+	/* ST-type only supports none and release ordering */
+	if (is_st && ord != 0 && ord != 2) {
+		return false;
+	}
+
+	addr   = get_saved_state_reg(state, rn);
+	rs_val = get_saved_state_reg(state, rs);
+	rt_val = (op_sub == 0x1f) ? get_saved_state_reg(state, rt) : 0;
+
+	sagit_lse_fn_t fn = sagit_lse_table[is_st ? 1 : 0][op_idx][size][ord];
+	if (fn == NULL) {
+		return false;
+	}
+
+	ret = fn(addr, rs_val, rt_val);
+	if (ret.status != 0) {
+		/* Fault on the user address; fall through to SIGSEGV */
+		return false;
+	}
+
+	if (!is_st) {
+		set_saved_state_reg(state, rt, ret.old_val);
+	}
+	add_saved_state_pc(state, 4);
+	return true;
+}
