+	mov		w1, #0
+	ret
+9:
+	mov		w1, #1
+	ret
+.endm
+
+/* ---------------- LD-type doubleword (64-bit) ---------------- */
+.macro LD_ATOMIC_X name, alu_op, ld_insn, st_insn
+.globl _\name
+\name:
+	COPYIO_RECOVER_RANGE 9f, 9f
+1:
