+/*
+ * SAGIT LSE atomic emulation helpers.
+ *
+ * Userspace LSE atomics are undefined on ARMv8.0 (Cortex-A73/A53 in MSM8998).
+ * The kernel traps them and calls these helpers, each implemented with an
+ * LDXR/STXR loop so atomicity is preserved across CPUs.
+ *
+ * Each helper uses COPYIO_RECOVER_RANGE so a fault on the user address
+ * returns an error instead of panicking.
+ *
+ * Calling convention:
+ *   LD-type / SWP:  x0 = addr, x1 = Rs value
+ *                   returns x0 = old value, x1 = 0 (success) or 1 (fault)
+ *   CAS:            x0 = addr, x1 = expected (Rs), x2 = new (Rt)
+ *                   returns x0 = old value, x1 = 0 or 1
+ *   ST-type:        x0 = addr, x1 = Rs value
+ *                   returns w0 = 0 (success) or 1 (fault)
+ *
+ * Naming: sagit_<op><size>[_a|_l|_al]
+ *   size: b=byte, h=halfword, (none)=32-bit, _x=64-bit
+ */
+
+#include "asm.h"
+
+/* BITCLR rd, rn, rm : rd = rn & ~rm */
+.macro BITCLR rd, rn, rm
+	mvn	\rd, \rm
+	and	\rd, \rd, \rn
+.endm
+
+/* Signed/unsigned min/max using cmp+csel (ARMv8.0 has no smax/smin/umax/umin) */
+.macro SMAX_W rd, rn, rm
+	cmp	\rn, \rm
+	csel	\rd, \rn, \rm, ge
+.endm
+.macro SMIN_W rd, rn, rm
+	cmp	\rn, \rm
+	csel	\rd, \rn, \rm, le
+.endm
+.macro UMAX_W rd, rn, rm
+	cmp	\rn, \rm
+	csel	\rd, \rn, \rm, hs
+.endm
+.macro UMIN_W rd, rn, rm
+	cmp	\rn, \rm
+	csel	\rd, \rn, \rm, ls
+.endm
+.macro SMAX_X rd, rn, rm
+	cmp	\rn, \rm
+	csel	\rd, \rn, \rm, ge
+.endm
+.macro SMIN_X rd, rn, rm
+	cmp	\rn, \rm
+	csel	\rd, \rn, \rm, le
+.endm
+.macro UMAX_X rd, rn, rm
+	cmp	\rn, \rm
+	csel	\rd, \rn, \rm, hs
+.endm
+.macro UMIN_X rd, rn, rm
+	cmp	\rn, \rm
+	csel	\rd, \rn, \rm, ls
+.endm
+
+/* ---------------- LD-type byte ---------------- */
+.macro LD_ATOMIC_B name, alu_op, ld_insn, st_insn
+.globl _\name
+\name:
+	COPYIO_RECOVER_RANGE 9f, 9f
+1:
+	\ld_insn	w2, [x0]
+	\alu_op	w3, w2, w1
+	and		w3, w3, #0xff
+	\st_insn	w4, w3, [x0]
+	cbnz		w4, 1b
+	mov		w0, w2
+	mov		w1, #0
+	ret
+9:
+	mov		w1, #1
+	ret
+.endm
+
+/* ---------------- LD-type halfword ---------------- */
+.macro LD_ATOMIC_H name, alu_op, ld_insn, st_insn
+.globl _\name
+\name:
+	COPYIO_RECOVER_RANGE 9f, 9f
+1:
+	\ld_insn	w2, [x0]
+	\alu_op	w3, w2, w1
+	and		w3, w3, #0xffff
+	\st_insn	w4, w3, [x0]
+	cbnz		w4, 1b
+	mov		w0, w2
+	mov		w1, #0
+	ret
+9:
+	mov		w1, #1
+	ret
+.endm
+
+/* ---------------- LD-type word (32-bit) ---------------- */
+.macro LD_ATOMIC_W name, alu_op, ld_insn, st_insn
+.globl _\name
+\name:
+	COPYIO_RECOVER_RANGE 9f, 9f
+1:
+	\ld_insn	w2, [x0]
+	\alu_op	w3, w2, w1
+	\st_insn	w4, w3, [x0]
+	cbnz		w4, 1b
