+
+/* ---------------- CAS byte ---------------- */
+.macro CAS_B name, ld_insn, st_insn
+.globl _\name
+\name:
+	COPYIO_RECOVER_RANGE 9f, 9f
+1:
+	\ld_insn	w3, [x0]
+	cmp		w3, w1
+	b.ne		2f
+	\st_insn	w4, w2, [x0]
+	cbnz		w4, 1b
+2:
