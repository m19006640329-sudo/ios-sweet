From: SAGIT Port <sagit@local>
Subject: [PATCH] arm_vm_init: anchor the early framebuffer alias at low globals

The SWEET console alias was placed at VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE
because the ARM_LARGE_MEMORY layout makes VM_MIN_KERNEL_ADDRESS equal to
LOW_GLOBAL_BASE_ADDRESS.  The 4K granule layout puts VM_MIN_KERNEL_ADDRESS
64GB lower, in a different L1 table that arm_vm_init never allocates, so the
alias lookup asserted at arm_vm_init.c:1842.

Anchor at LOW_GLOBAL_BASE_ADDRESS instead; the two are identical in the
large-memory configuration.  Also map the whole 1080x1920 surface: a 4K L2
block only covers 2MB, while the console writes up to 8MB past the base.
---
 osfmk/arm64/arm_vm_init.c | 48 ++++++++++++++++++++++++++--------------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1828,25 +1828,32 @@
 #if defined(SWEET)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
- * Use the otherwise empty 32MB block above low globals and below gVirtBase
- * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ * Use the otherwise empty block above low globals and below gVirtBase for a
+ * Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.  The
+ * base must be LOW_GLOBAL_BASE_ADDRESS: with the 4K granule
+ * VM_MIN_KERNEL_ADDRESS is 64GB lower, in a separate L1 table.
  */
-#define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#define SWEET_EARLY_FB_VA (LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE)
+#define SWEET_EARLY_FB_PA 0x9c000000ULL
+#define SWEET_EARLY_FB_SIZE (1080ULL * 1920 * 4)
 
 static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	const vm_size_t span = (SWEET_EARLY_FB_SIZE + ARM_TT_L2_SIZE - 1) & ~(ARM_TT_L2_SIZE - 1);
+	assert(va + span <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
-	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (vm_size_t off = 0; off < span; off += ARM_TT_L2_SIZE) {
+		tt_entry_t *slot = &l2[((va + off) & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		assert(*slot == ARM_TTE_EMPTY);
+		*slot = (SWEET_EARLY_FB_PA + off) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
